# Salin menjadi .env lewat `npm run setup`. APP_KEY dan DB_PASSWORD diisi otomatis.
APP_NAME="Lola Sport Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# PostgreSQL dijalankan oleh compose.yaml memakai nilai yang sama.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55433
DB_DATABASE=lola_demo
DB_USERNAME=lola
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_COOKIE=lola_demo_session
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
LOG_CHANNEL=stack
LOG_LEVEL=debug
MAIL_MAILER=log
