# Salin menjadi .env hanya di server. Buat APP_KEY dan DB_PASSWORD acak di sana.
APP_NAME="Lola Sport Demo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DEMO-HOSTNAME
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_COOKIE=lola_v1_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
